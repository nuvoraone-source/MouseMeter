<Window x:Class="MouseMeter.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Border CornerRadius="14" Margin="10" Background="{StaticResource BgSurfaceBrush}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="22,20,22,18">

            <Grid>
                <TextBlock Text="Einstellungen" Style="{StaticResource SectionTitleText}" FontSize="16" />
                <Button x:Name="CloseButton"
                        Style="{StaticResource IconButton}"
                        Width="28" Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-6,-6,0"
                        ToolTip="Schließen"
                        Click="OnCloseClick">
                    <TextBlock Text="✕" FontSize="12" />
                </Button>
            </Grid>

            <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,0"
                       Text="Tracking, Autostart und Datenverwaltung folgen in einer der nächsten Versionen." />

            <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,14" />

            <TextBlock Text="Support" Style="{StaticResource TileLabelText}" />
            <Button x:Name="ContactButton"
                    Content="Kontakt zu nuvora aufnehmen"
                    Click="OnContactClick"
                    Cursor="Hand"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,8,0,0"
                    Padding="0,9"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12" FontWeight="SemiBold"
                    Background="{StaticResource BgSurfaceAltBrush}"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource TextPrimaryBrush}" />

        </StackPanel>
    </Border>
</Window>
