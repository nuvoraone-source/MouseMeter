<Window x:Class="MouseMeter.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Border CornerRadius="14" Margin="10" Background="{StaticResource BgSurfaceBrush}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="22,20,22,18">

            <Grid>
                <TextBlock Text="Einstellungen" Style="{StaticResource SectionTitleText}" FontSize="16" />
                <Button x:Name="CloseButton"
                        Style="{StaticResource IconButton}"
                        Width="28" Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-6,-6,0"
                        ToolTip="Schließen"
                        Click="OnCloseClick">
                    <TextBlock Text="✕" FontSize="12" />
                </Button>
            </Grid>

            <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,0"
                       Text="Weitere Tracking- und Datenverwaltungsoptionen (z. B. Export, Aufbewahrungsdauer) folgen in einer der nächsten Versionen." />

            <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,14" />

            <TextBlock Text="Start" Style="{StaticResource TileLabelText}" />
            <CheckBox x:Name="AutostartCheckBox"
                      Content="MouseMeter mit Windows starten"
                      Checked="OnAutostartToggled"
                      Unchecked="OnAutostartToggled"
                      Cursor="Hand"
                      Margin="0,8,0,0"
                      FontFamily="{StaticResource UiFont}"
                      FontSize="12"
                      Foreground="{StaticResource TextPrimaryBrush}" />

            <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,14" />

            <TextBlock Text="Updates" Style="{StaticResource TileLabelText}" />
            <CheckBox x:Name="AutoUpdateCheckBox"
                      Content="Updates automatisch installieren"
                      Checked="OnAutoUpdateToggled"
                      Unchecked="OnAutoUpdateToggled"
                      Cursor="Hand"
                      Margin="0,8,0,0"
                      FontFamily="{StaticResource UiFont}"
                      FontSize="12"
                      Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Text="Neue Versionen werden im Hintergrund von GitHub geladen und beim nächsten Neustart von MouseMeter automatisch installiert." />

            <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,14" />

            <TextBlock Text="Daten" Style="{StaticResource TileLabelText}" />
            <TextBlock x:Name="DataFilePathText"
                       Style="{StaticResource BodyText}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,8,0,0" />
            <Button x:Name="OpenDataFolderButton"
                    Content="Ordner öffnen"
                    Click="OnOpenDataFolderClick"
                    Cursor="Hand"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,8,0,0"
                    Padding="0,9"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12" FontWeight="SemiBold"
                    Background="{StaticResource BgSurfaceAltBrush}"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource TextPrimaryBrush}" />
            <Button x:Name="ExportCsvButton"
                    Content="Als CSV exportieren"
                    Click="OnExportCsvClick"
                    Cursor="Hand"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,8,0,0"
                    Padding="0,9"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12" FontWeight="SemiBold"
                    Background="{StaticResource BgSurfaceAltBrush}"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource TextPrimaryBrush}" />

            <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,14" />

            <TextBlock Text="Datenschutz" Style="{StaticResource TileLabelText}" />
            <Button x:Name="PrivacyButton"
                    Content="Datenschutzerklärung anzeigen"
                    Click="OnPrivacyClick"
                    Cursor="Hand"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,8,0,0"
                    Padding="0,9"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12" FontWeight="SemiBold"
                    Background="{StaticResource BgSurfaceAltBrush}"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource TextPrimaryBrush}" />

            <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,14" />

            <TextBlock Text="Support" Style="{StaticResource TileLabelText}" />
            <Button x:Name="ContactButton"
                    Content="Kontakt aufnehmen"
                    Click="OnContactClick"
                    Cursor="Hand"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,8,0,0"
                    Padding="0,9"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12" FontWeight="SemiBold"
                    Background="{StaticResource BgSurfaceAltBrush}"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource TextPrimaryBrush}" />

            <StackPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                <TextBlock Text="App entwickelt von Alexander Ziegemann"
                           Style="{StaticResource FooterText}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="nuvora.one@gmail.com"
                           Style="{StaticResource FooterText}"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
