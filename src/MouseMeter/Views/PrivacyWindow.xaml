<Window x:Class="MouseMeter.Views.PrivacyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datenschutz"
        Width="440" SizeToContent="Height" MaxHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Border CornerRadius="14" Margin="10" Background="{StaticResource BgSurfaceBrush}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid Margin="22,20,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="Datenschutz" Style="{StaticResource SectionTitleText}" FontSize="16" />
                <Button x:Name="CloseButton"
                        Style="{StaticResource IconButton}"
                        Width="28" Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-6,-6,0"
                        ToolTip="Schließen"
                        Click="OnCloseClick">
                    <TextBlock Text="✕" FontSize="12" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,14,0,0" MaxHeight="440"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               Text="MouseMeter arbeitet vollständig lokal. Es werden keine Daten an einen externen Server übertragen." />

                    <TextBlock Style="{StaticResource TileLabelText}" Margin="0,16,0,4" Text="Was gespeichert wird" />
                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               Text="Pro Kalendertag: zurückgelegte Mausstrecke, Aktivzeit, Anzahl Links-/Rechts-/Mittelklicks, Anzahl Tastaturanschläge und Scrollrad-Ausschläge. Zusätzlich der persönliche Geschwindigkeitsrekord über alle Tage hinweg." />

                    <TextBlock Style="{StaticResource TileLabelText}" Margin="0,16,0,4" Text="Was ausdrücklich nicht gespeichert wird" />
                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               Text="Bei Tastatureingaben wird ausschließlich die Anzahl der Anschläge gezählt - niemals, welche Taste gedrückt wurde oder welcher Text entsteht. Es werden weder Fensterinhalte noch Namen von Anwendungen, Dokumenten oder Webseiten erfasst." />

                    <TextBlock Style="{StaticResource TileLabelText}" Margin="0,16,0,4" Text="Speicherort" />
                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               Text="Als JSON-Datei im Unterordner 'data' neben dem Programm (portabel), ersatzweise im Ordner %AppData%\MouseMeter, falls der Programmordner nicht beschreibbar ist. Diese Datei kann jederzeit gelöscht werden, um alle Statistiken zurückzusetzen; eine entsprechende Funktion direkt in den Einstellungen folgt in einer der nächsten Versionen." />

                    <TextBlock Style="{StaticResource TileLabelText}" Margin="0,16,0,4" Text="Wie die Erfassung technisch funktioniert" />
                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               Text="MouseMeter liest Mausposition, Maustasten, Scrollrad und Tastencodes über systemweite Windows-Schnittstellen (Low-Level-Hooks), damit die Erfassung auch dann funktioniert, wenn eine andere Anwendung im Vordergrund ist. Diese Schnittstellen liefern ausschließlich die genannten Zähldaten." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
