<Window x:Class="MouseMeter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MouseMeter"
        Width="660" Height="560"
        MinWidth="660" MinHeight="560"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBaseBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== Kopfbereich ==================== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="{StaticResource LogoImage}"
                   Width="34" Height="34"
                   VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="MouseMeter" Style="{StaticResource WordmarkText}" />
                <TextBlock Text="Every Move Counts" Style="{StaticResource TaglineText}" Margin="1,1,0,0" />
            </StackPanel>

            <Button Grid.Column="2"
                    x:Name="SettingsButton"
                    Style="{StaticResource IconButton}"
                    ToolTip="Einstellungen"
                    VerticalAlignment="Center"
                    Click="OnSettingsClick">
                <Path Data="{StaticResource GearGeometry}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Width="18" Height="18"
                      Stretch="Uniform" />
            </Button>
        </Grid>

        <!-- ==================== Inhalt ==================== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,0">

                <Image Source="{StaticResource LogoImage}"
                       Width="46" Height="46"
                       Opacity="0.32"
                       HorizontalAlignment="Center" />

                <TextBlock Text="Dashboard"
                           Style="{StaticResource SectionTitleText}"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0" />

                <TextBlock Style="{StaticResource BodyText}"
                           TextAlignment="Center"
                           MaxWidth="420"
                           Margin="0,8,0,0"
                           Text="Die Live-Kacheln für Mausstrecke, Geschwindigkeit, Klicks und Tastaturanschläge folgen in der nächsten Version. Dieser Stand enthält das Grundgerüst: Programmstart, Startbildschirm und Anwendungsfenster." />

            </StackPanel>
        </Border>

        <!-- ==================== Statusleiste ==================== -->
        <Grid Grid.Row="2" Margin="2,12,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tracking" Style="{StaticResource FooterText}" />
                <Ellipse x:Name="StatusDot"
                         Width="7" Height="7"
                         Margin="8,0,6,0"
                         VerticalAlignment="Center"
                         Fill="{StaticResource StatusOffBrush}" />
                <TextBlock x:Name="StatusText" Style="{StaticResource FooterText}" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       x:Name="VersionText"
                       Style="{StaticResource FooterText}" />
        </Grid>

    </Grid>
</Window>
