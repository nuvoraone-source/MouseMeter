<Window x:Class="MouseMeter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MouseMeter"
        Width="720" Height="700"
        MinWidth="720" MinHeight="700"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBaseBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Kopfbereich -->
            <RowDefinition Height="Auto" />
            <!-- Zeitraum-Auswahl -->
            <RowDefinition Height="*" />
            <!-- Dashboard + Diagramm -->
            <RowDefinition Height="Auto" />
            <!-- Statusleiste -->
        </Grid.RowDefinitions>

        <!-- ==================== Kopfbereich ==================== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="{StaticResource LogoImage}"
                   Width="34" Height="34"
                   VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="MouseMeter" Style="{StaticResource WordmarkText}" />
                <TextBlock Text="Every Move Counts" Style="{StaticResource TaglineText}" Margin="1,1,0,0" />
            </StackPanel>

            <Button Grid.Column="2"
                    x:Name="SettingsButton"
                    Style="{StaticResource IconButton}"
                    ToolTip="Einstellungen"
                    VerticalAlignment="Center"
                    Click="OnSettingsClick">
                <Path Data="{StaticResource GearGeometry}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Width="18" Height="18"
                      Stretch="Uniform" />
            </Button>
        </Grid>

        <!-- ==================== Zeitraum-Auswahl ==================== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="4">
            <UniformGrid Rows="1" Columns="4">
                <RadioButton x:Name="PeriodDay" Content="Tag" GroupName="Zeitraum"
                             Style="{StaticResource PeriodButton}" IsChecked="True"
                             Checked="OnPeriodChanged" />
                <RadioButton x:Name="PeriodWeek" Content="Woche" GroupName="Zeitraum"
                             Style="{StaticResource PeriodButton}"
                             Checked="OnPeriodChanged" />
                <RadioButton x:Name="PeriodMonth" Content="Monat" GroupName="Zeitraum"
                             Style="{StaticResource PeriodButton}"
                             Checked="OnPeriodChanged" />
                <RadioButton x:Name="PeriodYear" Content="Jahr" GroupName="Zeitraum"
                             Style="{StaticResource PeriodButton}"
                             Checked="OnPeriodChanged" />
            </UniformGrid>
        </Border>

        <!-- ==================== Dashboard + Diagramm ==================== -->
        <StackPanel Grid.Row="2" Margin="0,14,0,0">

            <!-- Reihe 1: Mausstrecke / Geschwindigkeit / Durchschnitt / Rekord -->
            <UniformGrid Rows="1" Columns="4">
                <Border Style="{StaticResource Tile}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Mausstrecke" Style="{StaticResource TileLabelText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="DistanceValueText" Style="{StaticResource TileValueText}" Text="0,00" />
                            <TextBlock Text="m" Style="{StaticResource TileUnitText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Geschwindigkeit" Style="{StaticResource TileLabelText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="SpeedValueText" Style="{StaticResource TileValueText}" Text="0,00" />
                            <TextBlock Text="m/s" Style="{StaticResource TileUnitText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Durchschnitt" Style="{StaticResource TileLabelText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="AverageValueText" Style="{StaticResource TileValueText}" Text="0,00" />
                            <TextBlock Text="m/s" Style="{StaticResource TileUnitText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="Rekord" Style="{StaticResource TileLabelText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="RecordValueText" Style="{StaticResource TileValueText}" Text="0,00" />
                            <TextBlock Text="m/s" Style="{StaticResource TileUnitText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Reihe 2: Linksklicks / Rechtsklicks / Mittelklicks / Gesamtklicks -->
            <UniformGrid Rows="1" Columns="4" Margin="0,10,0,0">
                <Border Style="{StaticResource Tile}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Linksklicks" Style="{StaticResource TileLabelText}" />
                        <TextBlock x:Name="LeftClicksValueText" Style="{StaticResource TileValueText}"
                                   Text="0" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Rechtsklicks" Style="{StaticResource TileLabelText}" />
                        <TextBlock x:Name="RightClicksValueText" Style="{StaticResource TileValueText}"
                                   Text="0" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Mittelklicks" Style="{StaticResource TileLabelText}" />
                        <TextBlock x:Name="MiddleClicksValueText" Style="{StaticResource TileValueText}"
                                   Text="0" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="Gesamtklicks" Style="{StaticResource TileLabelText}" />
                        <TextBlock x:Name="TotalClicksValueText" Style="{StaticResource TileValueText}"
                                   Text="0" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Reihe 3: Tastaturanschläge und Scrollrad (je halbe Breite) -->
            <UniformGrid Rows="1" Columns="2" Margin="0,10,0,0">
                <Border Style="{StaticResource Tile}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tastaturanschläge"
                                   Style="{StaticResource TileLabelText}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="KeystrokesValueText"
                                   Grid.Column="1"
                                   Style="{StaticResource TileValueText}"
                                   Text="0" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Scrollrad"
                                   Style="{StaticResource TileLabelText}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,14,0">
                            <TextBlock Text="▲" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="ScrollForwardValueText"
                                       Style="{StaticResource TileValueText}" FontSize="16"
                                       Text="0" ToolTip="Vorwärts / hoch" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="▼" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="ScrollBackwardValueText"
                                       Style="{StaticResource TileValueText}" FontSize="16"
                                       Text="0" ToolTip="Rückwärts / runter" />
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Diagramm -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16" Height="150">
                <Grid>
                    <TextBlock x:Name="ChartPlaceholderText"
                               Style="{StaticResource BodyText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" MaxWidth="380"
                               Text="Diagramm für den Tagesverlauf folgt, sobald der Verlauf dauerhaft gespeichert wird." />
                </Grid>
            </Border>

        </StackPanel>

        <!-- ==================== Statusleiste ==================== -->
        <Grid Grid.Row="3" Margin="2,12,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tracking" Style="{StaticResource FooterText}" />
                <Ellipse x:Name="StatusDot"
                         Width="7" Height="7"
                         Margin="8,0,6,0"
                         VerticalAlignment="Center"
                         Fill="{StaticResource StatusOffBrush}" />
                <TextBlock x:Name="StatusText" Style="{StaticResource FooterText}" />
            </StackPanel>

            <TextBlock x:Name="NuvoraLinkText"
                       Grid.Column="2"
                       Text="nuvora"
                       Background="Transparent"
                       Padding="10,4"
                       Style="{StaticResource LinkText}"
                       ToolTip="Kontakt zu nuvora aufnehmen"
                       MouseLeftButtonUp="OnNuvoraClick" />

            <TextBlock Grid.Column="4"
                       x:Name="VersionText"
                       Style="{StaticResource FooterText}" />
        </Grid>

    </Grid>
</Window>
