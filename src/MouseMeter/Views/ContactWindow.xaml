<Window x:Class="MouseMeter.Views.ContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kontakt"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Border CornerRadius="14" Margin="10" Background="{StaticResource BgSurfaceBrush}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="22,20,22,18">

            <Grid>
                <Image Source="{StaticResource LogoImage}" Width="26" Height="26" HorizontalAlignment="Left" />
                <Button x:Name="CloseButton"
                        Style="{StaticResource IconButton}"
                        Width="28" Height="28"
                        HorizontalAlignment="Right"
                        ToolTip="Schließen"
                        Click="OnCloseClick">
                    <TextBlock Text="✕" FontSize="12" />
                </Button>
            </Grid>

            <TextBlock Text="Kontakt zu nuvora" Style="{StaticResource SectionTitleText}" Margin="0,14,0,0" />
            <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0"
                       Text="Fragen, Ideen oder Fehlermeldungen zu MouseMeter erreichen den Entwickler unter:" />

            <Border Background="{StaticResource BgSurfaceAltBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                    CornerRadius="8" Margin="0,12,0,0" Padding="12,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="EmailText"
                               Grid.Column="0"
                               Text="nuvoraone@gmx.de"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Button x:Name="CopyButton"
                            Grid.Column="1"
                            Content="Kopieren"
                            Click="OnCopyClick"
                            Cursor="Hand"
                            Padding="10,4"
                            FontFamily="{StaticResource UiFont}"
                            FontSize="11" FontWeight="Medium"
                            Background="Transparent"
                            BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="1"
                            Foreground="{StaticResource TextPrimaryBrush}" />
                </Grid>
            </Border>

            <Button x:Name="MailButton"
                    Content="E-Mail-Programm öffnen"
                    Click="OnOpenMailClick"
                    Cursor="Hand"
                    HorizontalAlignment="Stretch"
                    Margin="0,14,0,0"
                    Padding="0,9"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12" FontWeight="SemiBold"
                    Background="{StaticResource AccentGradientBrush}"
                    BorderThickness="0"
                    Foreground="#0E1116" />

        </StackPanel>
    </Border>
</Window>
